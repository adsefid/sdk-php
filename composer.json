{
    "name": "adsefid/sdk",
    "description": "PHP SDK for the adsefid.com SMS Web Service REST API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Provides a PSR-18 HTTP client implementation for discovery to find automatically",
        "symfony/http-client": "Provides a PSR-18 HTTP client implementation (via symfony/http-client psr18 adapter) for discovery to find automatically",
        "guzzlehttp/psr7": "Provides PSR-17 request/stream factories for discovery to find automatically"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Adsefid\\Sdk\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "phpstan analyse",
        "fmt": "php-cs-fixer fix",
        "fmt:check": "php-cs-fixer fix --dry-run --diff",
        "test": "phpunit"
    },
    "homepage": "https://github.com/adsefid/sdk-php",
    "support": {
        "source": "https://github.com/adsefid/sdk-php",
        "issues": "https://github.com/adsefid/sdk-php/issues"
    },
    "autoload-dev": {
        "psr-4": {
            "Adsefid\\Sdk\\Tests\\": "tests/"
        }
    }
}
